# Beats PM Antigravity Brain - Git Ignore
# ========================================
# SKELETON PRIVACY STRATEGY
# ========================================
# Goal: Share folder STRUCTURE, never share CONTENT.
# - All processed files in 0-6 folders are ignored.
# - .gitkeep files preserve the folder structure in git.
# - System logic (Beats-PM-System, KERNEL.md) is versioned.
# ========================================

# ----------------------------------------
# 1. GLOBAL DEV EXCLUDES
# ----------------------------------------
.DS_Store
Thumbs.db
node_modules/
.env
.env.*
package-lock.json
*.log
__pycache__/
*.pyc
*.bak
.gemini/config.json

# Local Trello API credentials and sync state
system/config.json
system/config/trello_config.json
5. Trackers/.trello_ledger.json

# Local Obsidian vault paths, MCP keys, and sync preferences
system/config/obsidian.local*.json

# Local Beats runtime diagnostics, caches, and test logs
/.beats/
/.agent/cache/
/test_logs/

# Local MCP runtime configuration, OAuth state, and diagnostics
system/config/mcp.local*.json
system/config/mcp.*.local.json
system/config/critical_intake.local*.json
system/config/mcp-diagnostics/**
system/config/mcp-runtime/**
.gemini/state/
TEST-REPORT.md
requirements.txt

# ----------------------------------------
# 2. PROCESSED DATA FOLDERS (FULL PRIVACY)
# ----------------------------------------
# Strategy: Ignore ALL files in these folders, keep directories.
# The pattern "folder/**" ignores all contents recursively.
# The pattern "!folder/**/" preserves directory structure.
# The pattern "!folder/**/.gitkeep" preserves .gitkeep files.

# 0. Incoming (raw intake)
/0. Incoming/**
!/0. Incoming/
!/0. Incoming/.gitkeep
!/0. Incoming/**/
!/0. Incoming/**/.gitkeep

# 1. Company (profiles, strategy)
/1. Company/**
!/1. Company/
!/1. Company/.gitkeep
!/1. Company/**/
!/1. Company/**/.gitkeep

# 2. Products (PRDs, initiatives, bugs)
/2. Products/**
!/2. Products/
!/2. Products/.gitkeep
!/2. Products/**/
!/2. Products/**/.gitkeep

# 3. Meetings (notes, briefs, transcripts)
/3. Meetings/**
!/3. Meetings/
!/3. Meetings/.gitkeep
!/3. Meetings/**/
!/3. Meetings/**/.gitkeep

# 4. People (stakeholder directory)
/4. People/**
!/4. People/
!/4. People/.gitkeep
!/4. People/**/
!/4. People/**/.gitkeep

# 5. Trackers (bugs, boss-requests, projects)
/5. Trackers/**
!/5. Trackers/
!/5. Trackers/.gitkeep
!/5. Trackers/**/
!/5. Trackers/**/.gitkeep

# 6. SOPs (local standard operating procedures, runbooks, examples)
/6. SOPs/**
!/6. SOPs/
!/6. SOPs/.gitkeep
!/6. SOPs/**/
!/6. SOPs/**/.gitkeep

# 7. Partners (technology & channel partners — contracts, contacts, runbooks)
/7. Partners/**
!/7. Partners/
!/7. Partners/.gitkeep
!/7. Partners/**/
!/7. Partners/**/.gitkeep

# 8. Clients (health plans, health systems — accounts, contacts, expansions)
/8. Clients/**
!/8. Clients/
!/8. Clients/.gitkeep
!/8. Clients/**/
!/8. Clients/**/.gitkeep

# ----------------------------------------
# 3. USER CONFIGURATION (SENSITIVE)
