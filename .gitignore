/scratch/

# ----------------------------------------
# 4. SYSTEM LOGIC (VERSIONED - KEEP THESE)
# ----------------------------------------
# Core system files to share
!/KERNEL.md
!/README.md
!/.gitignore
!/.antigravityignore

# Beats-PM-System is the public template
!/Beats-PM-System/

# But exclude runtime/transient data within it
/Beats-PM-System/system/inbox/**
!/Beats-PM-System/system/inbox/.gitkeep
/Beats-PM-System/system/logs/**
!/Beats-PM-System/system/logs/.gitkeep
/Beats-PM-System/system/queue/**
!/Beats-PM-System/system/queue/.gitkeep
/Beats-PM-System/system/backups/**
!/Beats-PM-System/system/backups/.gitkeep
# Ignore Vibe Reports (Local Only)
/Beats-PM-System/reports/**
!/Beats-PM-System/reports/.gitkeep

